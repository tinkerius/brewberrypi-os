image <IMAGE_NAME>.<IMAGE_SUFFIX>.sparse {
   android-sparse {
      image = <IMAGE_NAME>.<IMAGE_SUFFIX>
   }
}

image <IMAGE_NAME>.<IMAGE_SUFFIX> {
   hdimage {
      align = 8M
      partition-table-type = "mbr"
      fill = true
      disk-signature = "<DISK_SIGNATURE>"
   }

   partition boot {
      in-partition-table = true
      partition-type = 0xC
      image = boot.vfat
      bootable = true
   }

   partition root {
      in-partition-table = true
      partition-type = 0x83
      image = root.ext4
   }

   # Must stay last: brewberry-growdata grows it to the end of the card.
   partition data {
      in-partition-table = true
      partition-type = 0x83
      image = data.ext4
   }
}

image boot.vfat {
   vfat {
      label = "BOOT"
      extraargs = "<VFAT_EXTRAARGS>"
   }
   size = <FW_SIZE>
   mountpoint = "/boot/firmware"
   exec-pre = "<SETUP> BOOT"
}

image root.ext4 {
   ext4 {
      label = "ROOT"
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      extraargs = "<MKE2FS_EXTRAARGS>"
   }
   size = <ROOT_SIZE>
   mountpoint = "/"
   exec-pre = "<SETUP> ROOT"
}

# Empty on purpose: brewberry-datalayout creates the /data tree on first boot.
image data.ext4 {
   empty = true
   ext4 {
      label = "DATA"
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      extraargs = "<DATA_MKE2FS_EXTRAARGS>"
   }
   size = <DATA_SIZE>
}
