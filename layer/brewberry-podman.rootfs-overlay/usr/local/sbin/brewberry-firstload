#!/bin/sh
# Make sure localhost/brewberrypi:active exists. On first boot, or after /data
# was wiped, import the app image preloaded in the OS image and tag it active.
# Does nothing when the tag already exists.
set -eu

ACTIVE=localhost/brewberrypi:active
# 'dir:' format; policy.json accepts unsigned images from this path only.
PRELOAD=/usr/share/brewberrypi/preload

if podman image exists "$ACTIVE"; then
   exit 0
fi
[ -f "$PRELOAD/manifest.json" ] || { echo "no $ACTIVE and no preloaded image" >&2; exit 1; }

id=$(podman pull -q "dir:$PRELOAD")
[ -n "$id" ] || { echo "podman pull dir:$PRELOAD reported no image" >&2; exit 1; }
podman tag "$id" "$ACTIVE"
sync -f /data
echo "loaded the preloaded image ($id) as $ACTIVE"
