# BrewberryPi app (runtime contract version 2, ADR-0001). Rendered at build time
# by layer/brewberry-podman.yaml, which fills in the GIDs of the host groups gpio
# and brewberry-config and lists /dev/gpiochip0..31, each optional because chip
# numbers vary by kernel.
#
# Safety (OS3, runtime contract §6): the outputs-off reset runs after every
# stop, and the app must ping the watchdog. Never remove either.
# Supervision (OS4): exit codes 1 and 4 (and watchdog kills) are restarted; the
# 4th start within 10 minutes that fails ends in safe mode, which falls back to
# the previous image once. Exit codes 2 and 3 (configuration errors) are not
# restarted and never switch images.

[Unit]
Description=BrewberryPi
Requires=data.mount
Wants=brewberry-firstload.service
After=data.mount brewberry-datalayout.service brewberry-firstload.service
StartLimitIntervalSec=10min
StartLimitBurst=4
OnFailure=brewberrypi-safemode.service

[Container]
Image=localhost/brewberrypi:active
Pull=never
ContainerName=brewberrypi
Notify=true
# The app image's user (tinkerius/brewberrypi Containerfile); never root.
User=10001
Group=10001
GroupAdd=@GPIO_GID@
# brewberry-config owns /data/config/app (set-group-ID, 2775): the app writes
# its config.json and recipes/ there, and the share's user edits them.
GroupAdd=@CONFIG_GID@
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Network=host
# Only the app's folder; /data/config/os (Wi-Fi passwords) stays outside.
Volume=/data/config/app:/config
# The contract's command. $BREWBERRYPI_ARGS is empty, or --dummymode in demo
# mode (brewberry-update demo on: the app simulates the kettle and never touches
# GPIO); systemd expands it from the EnvironmentFile below.
Exec=--config /config/config.json $BREWBERRYPI_ARGS
# The container does not get WATCHDOG_USEC; the app pings at this interval.
Environment=BREWBERRYPI_WATCHDOG_MS=5000
@GPIO_DEVICES@

[Service]
Restart=on-failure
# Without this, OnFailure= would fire on every crash (systemd 257).
RestartMode=direct
RestartSec=3
EnvironmentFile=-/data/update/app-args.env
RestartPreventExitStatus=2 3
TimeoutStartSec=60
WatchdogSec=20
# Remembers the outputs of the config the app starts with: the config can
# change while it runs (import, file share), and the reset must still switch
# off the pins the app drives.
ExecStartPre=+/usr/local/sbin/brewberrypi-outputs-off --record
# Port 80 forwarded to the app's port of that config (ADR-0006); never fails.
ExecStartPre=-+/usr/local/sbin/brewberrypi-port80
# Runs on every exit path (clean stop, crash, kill -9, watchdog, failed start),
# before Quadlet's own cleanup: removes the container, then drives the recorded
# outputs and every output from /data/config/app/config.json to its off level
# (the default pins while the app has not written it yet).
ExecStopPost=+/usr/local/sbin/brewberrypi-outputs-off %t/%N.cid

[Install]
WantedBy=multi-user.target
