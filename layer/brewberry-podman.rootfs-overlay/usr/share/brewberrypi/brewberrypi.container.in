# BrewberryPi app (runtime contract version 1, ADR-0001). Rendered at build time
# by layer/brewberry-podman.yaml, which fills in the host gpio group's GID and
# lists /dev/gpiochip0..31, each optional because chip numbers vary by kernel.
#
# Safety (OS3, runtime contract §6): the outputs-off reset runs after every
# stop, and the app must ping the watchdog. Never remove either.
# Added in OS4: start limits, RestartMode=direct, safe mode and /update.

[Unit]
Description=BrewberryPi
Requires=data.mount
Wants=brewberry-firstload.service
After=data.mount brewberry-datalayout.service brewberry-firstload.service

[Container]
Image=localhost/brewberrypi:active
Pull=never
ContainerName=brewberrypi
Notify=true
# The app image's user (tinkerius/brewberrypi Containerfile); never root.
User=10001
Group=10001
GroupAdd=@GPIO_GID@
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Network=host
Volume=/data/config:/config:ro
# The container does not get WATCHDOG_USEC; the app pings at this interval.
Environment=BREWBERRYPI_WATCHDOG_MS=5000
@GPIO_DEVICES@

[Service]
Restart=on-failure
TimeoutStartSec=60
WatchdogSec=20
# Runs on every exit path (clean stop, crash, kill -9, watchdog, failed start),
# before Quadlet's own cleanup: removes the container, then drives every output
# from /data/config/config.json to its off level.
ExecStopPost=+/usr/local/sbin/brewberrypi-outputs-off %t/%N.cid

[Install]
WantedBy=multi-user.target
