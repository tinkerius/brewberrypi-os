#!/bin/sh
# Create the /data layout (ADR-0001). Runs on every boot; only creates what is
# missing, so a healthy /data is not written to.
set -eu

# BREWBERRY_DATA_ROOT and BREWBERRY_CONFIG_OWNER are for tests only
# (tests/unit/datalayout.sh).
D=${BREWBERRY_DATA_ROOT:-/data}
# The share's user and the group the app container gets (GroupAdd=): both
# may change everything in config/app and config/os (ADR-0003).
OWNER=${BREWBERRY_CONFIG_OWNER:-brewberry:brewberry-config}

mountpoint -q "$D" || { echo "$D is not mounted" >&2; exit 1; }

created=0
ensure_dir() { # <mode> <path> [owner]
   if [ ! -d "$2" ]; then
      install -d -m "$1" ${3:+-o "${3%%:*}" -g "${3#*:}"} "$2"
      echo "created $2"
      created=1
   fi
}

# config is the file share's root (\\<hostname>.local\config). It belongs to
# root, so nobody can rename or delete its two folders over the share:
#   app  the app's own folder, mounted read-write at /config (runtime contract
#        2): the app writes config.json with its defaults and creates recipes/
#        with its shipped recipes when they are missing. Nothing seeds them.
#   os   the OS's files: wifi.json, backups.
# Set-group-ID: files created in them belong to the group, whoever writes.
ensure_dir 0755 "$D/config"
ensure_dir 2775 "$D/config/app" "$OWNER"
ensure_dir 2775 "$D/config/os" "$OWNER"
ensure_dir 0755 "$D/containers/storage"  # Podman graphroot (OS2)
ensure_dir 0755 "$D/tmp"                 # Podman pull staging (OS2)
ensure_dir 0755 "$D/update"              # update requests, state, tags.json (OS4)
ensure_dir 0700 "$D/secrets"             # registry auth.json (OS4)

[ "$created" -eq 0 ] || sync -f "$D"
