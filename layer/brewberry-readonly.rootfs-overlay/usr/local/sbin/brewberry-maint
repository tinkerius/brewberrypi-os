#!/bin/bash
# Maintenance mode for OS updates (ADR-0001, OS6). Run as root.
#
#   brewberry-maint status         sealed or in maintenance mode
#   brewberry-maint on [--yes]     unseal: after a reboot, root and boot are writable
#   brewberry-maint off [--yes]    seal again (overlay root, read-only boot) and reboot
#
# OS update: brewberry-maint on; apt update && apt full-upgrade; brewberry-maint off.
# Pulling the plug is NOT safe from 'on' until 'off' has rebooted.
#
# Instead of raspi-config's overlay toggle (which also covers /data and only
# knows 'overlayroot=tmpfs'). Sealing itself is brewberry-seal (OS1), so there
# is one implementation of it.
set -euo pipefail

# BREWBERRY_MAINT_ROOT is for tests only (tests/unit/maint.sh).
R=${BREWBERRY_MAINT_ROOT:-}
PARAM=overlayroot=tmpfs:recurse=0
BOOT=$R/boot/firmware
CMDLINE=$BOOT/cmdline.txt
LOWER=$R/media/root-ro    # the real root below the overlay
FLAG=/etc/brewberry/maintenance

log() { echo "brewberry-maint: $*" >&2; }
die() { log "$*"; exit 1; }
sealed() { grep -q 'overlayroot=' "$R/proc/cmdline"; }

confirm() { # <what>
   [ "${YES:-0}" = 1 ] && return 0
   echo "$1" >&2
   echo "This reboots the Pi and ends a running brew. Type 'yes' to continue:" >&2
   local answer
   read -r answer
   [ "$answer" = yes ] || die "cancelled"
}

cmd_status() {
   if sealed; then
      echo "sealed: overlay root, read-only boot"
      [ -e "$LOWER$FLAG" ] && echo "maintenance mode starts at the next boot"
   else
      echo "NOT sealed: root and boot are writable"
      [ -e "$R$FLAG" ] && echo "maintenance mode since $(cat "$R$FLAG")"
   fi
   return 0
}

cmd_on() {
   sealed || die "not sealed: maintenance mode is already on (or first boot has not finished)"
   confirm "Maintenance mode: the next boot has a writable root and boot partition."

   # 1. Kernel command line without the overlay. A power cut after this step
   #    boots unsealed without the maintenance flag, and brewberry-seal seals
   #    again by itself.
   mount -o remount,rw "$BOOT"
   tr ' ' '\n' < "$CMDLINE" | grep -vx "$PARAM" | grep -v '^$' | paste -sd ' ' > "$CMDLINE.brewberry-maint"
   grep -q 'root=' "$CMDLINE.brewberry-maint" || die "cmdline.txt would lose root=; not changed"
   sync "$CMDLINE.brewberry-maint"
   mv "$CMDLINE.brewberry-maint" "$CMDLINE"
   sync "$BOOT"
   mount -o remount,ro "$BOOT"
   log "removed $PARAM from cmdline.txt"

   # 2. In the real root: the maintenance flag (keeps brewberry-seal from
   #    sealing) and a writable boot partition.
   mount -o remount,rw "$LOWER"
   mkdir -p "$LOWER$(dirname "$FLAG")"
   date -u +%Y-%m-%dT%H:%M:%SZ > "$LOWER$FLAG.tmp"
   sync "$LOWER$FLAG.tmp"
   mv "$LOWER$FLAG.tmp" "$LOWER$FLAG"
   sed -i -E 's|^([^#]+[[:space:]]/boot/firmware[[:space:]]+vfat[[:space:]]+)ro,|\1rw,|' "$LOWER/etc/fstab"
   grep -Eq '^[^#]+[[:space:]]/boot/firmware[[:space:]]+vfat[[:space:]]+rw,' "$LOWER/etc/fstab" ||
      log "could not make /boot/firmware writable in fstab; remount it by hand before apt"
   sync -f "$LOWER"
   mount -o remount,ro "$LOWER"

   log "rebooting into maintenance mode"
   systemctl --no-block reboot
}

cmd_off() {
   sealed && die "already sealed"
   # An upgrade must not have dropped the safety block (OS3) from config.txt.
   # Its gpio= lines may legitimately differ (moved pins), so check the block's
   # marker, strict_gpiod and that some pins still get boot-time levels.
   if ! grep -q '^# --- BrewberryPi' "$BOOT/config.txt" ||
      ! grep -qx 'dtparam=strict_gpiod' "$BOOT/config.txt" ||
      ! grep -q '^gpio=[0-9].*=op,' "$BOOT/config.txt"; then
      die "config.txt has lost the BrewberryPi safety block (strict_gpiod, gpio= boot pins); restore it before sealing"
   fi
   confirm "Seal again: overlay root and read-only boot after a reboot."
   # Without the flag, a power cut before the seal finishes is repaired by
   # brewberry-seal.service at the next boot.
   rm -f "$R$FLAG"
   sync -f "$R/etc"
   brewberry-seal
}

[ -n "$R" ] || [ "$(id -u)" = 0 ] || die "run as root"
YES=0
[ "${2:-}" = --yes ] && YES=1
case ${1:-} in
   status) cmd_status ;;
   on) cmd_on ;;
   off) cmd_off ;;
   *) sed -n '2,9s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
