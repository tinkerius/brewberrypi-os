#!/bin/sh
# Drive every BrewberryPi output to its off level (runtime contract §6,
# NFR-003). Runs as ExecStopPost= of brewberrypi.service, so after every stop:
# clean exit, crash, kill -9, watchdog kill, failed start, container removal.
#
#   brewberrypi-outputs-off [cidfile]   reset the outputs
#   brewberrypi-outputs-off --record    ExecStartPre=: remember the outputs of
#                                       the config the app starts with
#
# 1. Remove the container, so no process holds the GPIO lines any more and
#    nothing can drive them again.
# 2. The outputs the app was started with (--record, in /run). The config can
#    change while the app runs (brewberry-config import, the file share of
#    ADR-0003); these are the pins the app actually drives, so they go first
#    and keep their off level.
# 3. The outputs in /data/config/config.json (hardware.heating, .pump,
#    .buzzer: pin, activeLow). Missing keys, a missing file or an unreadable
#    file mean the app's built-in defaults: heating 23 and pump 22 active-low,
#    buzzer 10 active-high. Those are also the boot-time pins in config.txt.
#    Pins already reset in step 2 are left alone.
#
# Each output is driven with pinctrl, which drives the pins directly whatever
# holds the lines: active-low outputs become outputs driven high with pull-up,
# active-high ones outputs driven low with pull-down. The heater goes first.
#
# Never stops early: every output is attempted even if a step fails. Exits 1
# if anything failed, so the failure shows in the journal.
set -u

# BREWBERRYPI_OUTPUTS_CONFIG and BREWBERRYPI_OUTPUTS_STARTED are for tests
# only; systemd never sets them.
CONFIG=${BREWBERRYPI_OUTPUTS_CONFIG:-/data/config/config.json}
STARTED=${BREWBERRYPI_OUTPUTS_STARTED:-/run/brewberrypi/outputs-started}
rc=0

log() { echo "brewberrypi-outputs-off: $*"; }

# Outputs as "name pin activeLow", heater first.
DEFAULTS='heating 23 true
pump 22 true
buzzer 10 false'

# Sets outputs from the config: the defaults if there is none, empty if it
# can't be read.
read_config() {
   outputs=$DEFAULTS
   [ -r "$CONFIG" ] || return 0
   outputs=$(jq -r '
      def or_default($v; $d): if $v == null then $d else $v end;
      (.hardware // {}) as $h
      | [["heating", 23, true], ["pump", 22, true], ["buzzer", 10, false]][]
      | . as [$name, $pin, $low]
      | "\($name) \(or_default($h[$name].pin; $pin)) \(or_default($h[$name].activeLow; $low))"
   ' "$CONFIG" 2>/dev/null) || outputs=""
}

valid_pin() { case $1 in [0-9] | 1[0-9] | 2[0-7]) return 0 ;; *) return 1 ;; esac; }
valid_low() { case $1 in true | false) return 0 ;; *) return 1 ;; esac; }

# --record, just before the container starts. A config the app will refuse
# (unreadable, invalid pins) is not recorded: the app never drives its pins.
if [ "${1:-}" = --record ]; then
   rm -f "$STARTED"
   read_config
   [ -n "$outputs" ] || { log "cannot read $CONFIG; nothing recorded"; exit 0; }
   while read -r name pin low; do
      if ! valid_pin "$pin" || ! valid_low "$low"; then
         log "$name: invalid pin or activeLow in $CONFIG; nothing recorded"
         exit 0
      fi
   done <<END
$outputs
END
   if mkdir -p "${STARTED%/*}" && printf '%s\n' "$outputs" > "$STARTED.tmp" && mv "$STARTED.tmp" "$STARTED"; then
      exit 0
   fi
   log "cannot write $STARTED"
   exit 1
fi
CIDFILE=${1:-}

# 1. Release the lines.
if [ -n "$CIDFILE" ] && [ -f "$CIDFILE" ]; then
   podman rm -f -t 0 -i --cidfile "$CIDFILE" >/dev/null 2>&1 || true
fi
podman rm -f -t 0 -i brewberrypi >/dev/null 2>&1 || true

# pinctrl writes the function before the level, so a pin that was an input may
# show its old output latch for microseconds: far too short to switch a relay.
off() { # <name> <pin> <activeLow>
   if [ "$3" = true ]; then opts="op pu dh"; else opts="op pd dl"; fi
   # shellcheck disable=SC2086  # opts is a list of pinctrl options
   if pinctrl set "$2" $opts; then
      log "$1 (BCM $2, activeLow $3) off"
   else
      log "$1 (BCM $2): pinctrl failed"
      rc=1
   fi
}

# 2. The outputs the running app drove.
started_pins=" "
if [ -f "$STARTED" ]; then
   while read -r name pin low; do
      if ! valid_pin "$pin" || ! valid_low "$low"; then
         log "$STARTED: bad line '$name $pin $low'"
         rc=1
         continue
      fi
      off "$name" "$pin" "$low"
      started_pins="$started_pins$pin "
   done < "$STARTED"
fi

# off_unless_started <name> <pin> <activeLow>
off_unless_started() {
   case $started_pins in
      *" $2 "*) log "$1 (BCM $2): already off as the running app's config had it" ;;
      *) off "$1" "$2" "$3" ;;
   esac
}

# 3. The outputs in the config now.
read_config
if [ -z "$outputs" ]; then
   log "cannot read $CONFIG; using the default pins"
   outputs=$DEFAULTS
   rc=1
fi

bad=0
while read -r name pin low; do
   valid_pin "$pin" || { log "$name: invalid pin '$pin' in $CONFIG"; bad=1; continue; }
   valid_low "$low" || { log "$name: invalid activeLow '$low' in $CONFIG"; bad=1; continue; }
   off_unless_started "$name" "$pin" "$low"
done <<END
$outputs
END

# The app refuses an invalid config and never drives its pins, so they are
# still as the firmware set them at boot: the defaults. Reset those too.
if [ "$bad" -ne 0 ]; then
   rc=1
   while read -r name pin low; do
      off_unless_started "$name" "$pin" "$low"
   done <<END
$DEFAULTS
END
fi
exit "$rc"
