<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- The file share (ADR-0003, OS10), so the Pi shows up in macOS Finder's and Linux file managers' network lists. -->
<service-group>
  <name replace-wildcards="yes">BrewberryPi OS %h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
</service-group>
