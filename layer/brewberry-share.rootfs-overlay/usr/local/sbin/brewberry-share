#!/bin/bash
# The file share of the app's configuration (ADR-0003, OS10). Run as root.
#
#   brewberry-share status    on or off, its address, and whether it has a password
#   brewberry-share on        share /data/config on the network (the default)
#   brewberry-share off       stop sharing it, also after reboots
#
# Options: --json (status). The share is \\<hostname>.local\config (Windows) or
# smb://<hostname>.local/config (macOS, Linux): user brewberry, the same
# password as the device web interface. The app reads its configuration at
# start: after changing files, run 'brewberry-update restart'.
set -euo pipefail

PROG=brewberry-share
# BREWBERRY_LIB, BREWBERRY_SHARE_ROOT and BREWBERRY_SHARE_USER are for tests
# (tests/unit/share.sh).
# shellcheck source=layer/brewberry-base.rootfs-overlay/usr/lib/brewberry/common.sh
. "${BREWBERRY_LIB:-/usr/lib/brewberry}/common.sh"
R=${BREWBERRY_SHARE_ROOT:-}
SHARE_USER=${BREWBERRY_SHARE_USER:-brewberry}
PRIVATE=$R/data/secrets/samba
DISABLED=$PRIVATE/disabled          # smbd.service's ConditionPathExists=!
RECORD=$PRIVATE/account-hash
DEFAULT_HASH=$R/usr/share/brewberry/default-password.hash

# set: the account's password, default: still 'pi', missing: none (logins fail).
password_state() {
   local hash
   hash=$(awk -F: -v u="$SHARE_USER" '$1 == u { print $2 }' "$R/etc/shadow")
   if [ -z "$hash" ] || ! pdbedit -L 2> /dev/null | grep -q "^$SHARE_USER:" ||
      [ ! -f "$RECORD" ] || [ "$(cat "$RECORD")" != "$hash" ]; then
      echo missing
   elif [ -f "$DEFAULT_HASH" ] && [ "$(cat "$DEFAULT_HASH")" = "$hash" ]; then
      echo default
   else
      echo set
   fi
}

cmd_status() {
   local host enabled=true running=false state
   host=$(hostname)
   [ ! -e "$DISABLED" ] || enabled=false
   systemctl is-active --quiet smbd.service && running=true
   state=$(password_state)
   if [ "$JSON" = 1 ]; then
      jq -n --argjson enabled "$enabled" --argjson running "$running" --arg host "$host" \
         --arg user "$SHARE_USER" --arg password "$state" \
         '{enabled: $enabled, running: $running, user: $user, password: $password,
           windows: "\\\\\($host).local\\config", url: "smb://\($host).local/config"}'
      return
   fi
   echo "share:    $([ "$enabled" = true ] && echo on || echo off) ($([ "$running" = true ] && echo running || echo not running))"
   printf 'address:  \\\\%s.local\\config (Windows), smb://%s.local/config (macOS, Linux)\n' "$host" "$host"
   echo "user:     $SHARE_USER"
   case $state in
      set) echo "password: the same as the device web interface" ;;
      default) echo "password: the default 'pi' (change it in the device web interface)" ;;
      *) echo "password: none yet: set the password again (web interface, Account, or passwd)" ;;
   esac
}

cmd_on() {
   if [ -e "$DISABLED" ]; then
      rm -f "$DISABLED"
      sync "$PRIVATE"
   fi
   systemctl start smbd.service
   log "the share is on: \\\\$(hostname).local\\config"
   [ "$(password_state)" != missing ] || log "it has no password yet: set the password again (web interface, Account, or passwd)"
}

cmd_off() {
   install -d -m 0700 "$PRIVATE"
   [ -e "$DISABLED" ] || : | write_atomic "$DISABLED"
   systemctl stop smbd.service
   log "the share is off, also after reboots (brewberry-share on to share again)"
}

[ -n "$R" ] || [ "$(id -u)" = 0 ] || die "run as root"
parse_opts "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
[ $# -le 1 ] || die "usage: brewberry-share status|on|off"
case ${1:-} in
   status) cmd_status ;;
   on) cmd_on ;;
   off) cmd_off ;;
   *) sed -n '2,11s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
