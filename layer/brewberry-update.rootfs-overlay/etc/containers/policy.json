{
  "default": [{ "type": "reject" }],
  "transports": {
    "docker": {
      "ghcr.io/tinkerius/brewberrypi-app": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/usr/share/brewberrypi/keys/app-cosign.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ]
    },
    "dir": {
      "/usr/share/brewberrypi/preload": [{ "type": "insecureAcceptAnything" }]
    }
  }
}
