#!/bin/bash
# The app's configuration in /data/config/app (ADR-0002, OS9). Run as root.
#
#   brewberry-config show            config.json and the recipe files
#   brewberry-config import <source> check, back up and replace config files:
#                                    <source> is a folder (*.json, recipes/), one
#                                    .json file, or a .tar.gz from 'export'
#   brewberry-config export          /data/config/app as .tar.gz on stdout
#
# Options: --json (show). The app reads config.json at start: after importing
# it, run 'brewberry-update restart'. Recipes it reads again by itself.
#
# The app owns the folder (runtime contract 2): it writes a missing config.json
# with its defaults and creates a missing recipes/ with its shipped recipes.
# A source folder looks like the app folder:
#   *.json      config.json (and other top-level configuration files)
#   recipes/    one file <id>.json per recipe (app RCP-001); replaces all
#               recipes on the Pi. Without it the recipes stay as they are.
# Every file is checked before anything is written; nothing changes if one is
# invalid. Replaced files go to /data/config/os/backup/<time>/.
set -euo pipefail

PROG=brewberry-config
# BREWBERRY_LIB and BREWBERRY_UPDATE_ROOT are for tests (tests/unit/config.sh).
# shellcheck source=layer/brewberry-base.rootfs-overlay/usr/lib/brewberry/common.sh
. "${BREWBERRY_LIB:-/usr/lib/brewberry}/common.sh"

ROOT=${BREWBERRY_UPDATE_ROOT:-}
CONFIG_DIR=$ROOT/data/config/app
BACKUP_DIR=$ROOT/data/config/os/backup
APP_CONFIG=$CONFIG_DIR/config.json
TMP_DIR=$ROOT/data/tmp
MAX_CONFIG_BYTES=1048576
MAX_ARCHIVE_BYTES=8388608
DEFAULT_PINS="heating:23 pump:22 buzzer:10"
CONFIG_RE='^[A-Za-z0-9._-]+\.json$'
RECIPE_RE='^[A-Za-z0-9_-]+\.json$' # the file name is the recipe id

WORK=""
cleanup() { [ -z "$WORK" ] || rm -rf "$WORK"; }
trap cleanup EXIT

config_files() { # <dir>: top-level .json files
   [ -d "$1" ] || return 0
   find "$1" -mindepth 1 -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort
}

recipe_files() { # <dir>: the app reads only <id>.json files directly in recipes/, not hidden ones
   [ -d "$1/recipes" ] || return 0
   find "$1/recipes" -mindepth 1 -maxdepth 1 -type f -name '*.json' ! -name '.*' -printf '%f\n' | sort
}

# check_file <path> <name shown> <name pattern> <pattern description>
check_file() {
   [ ! -L "$1" ] || die "$2: symbolic links are not imported"
   [[ ${1##*/} =~ $3 ]] || die "$2: file names may only contain $4"
   [ "$(stat -c %s "$1")" -le "$MAX_CONFIG_BYTES" ] || die "$2: larger than $MAX_CONFIG_BYTES bytes"
   jq empty "$1" 2> /dev/null || die "$2: not valid JSON; nothing imported"
}

# The folder's owner and group own what is written into it, group-writable:
# the file share (ADR-0003) and the app (through the group) can change it.
own() { chown -h --reference="$CONFIG_DIR" "$@"; }

# install_file <source> <target>: copy via a temp file and rename, so a power
# cut leaves the old or the new file, and the app never reads half a file.
install_file() {
   local tmp=${2%/*}/.${2##*/}.tmp
   rm -f "$tmp"
   cp "$1" "$tmp"
   chmod 0664 "$tmp"
   own "$tmp"
   sync "$tmp"
   mv "$tmp" "$2"
}

# Sets DIR, the folder to import from: the source itself, or a work folder on
# /data with the single file or the unpacked archive.
source_dir() { # <source>
   local src=$1 bad
   if [ -d "$src" ]; then
      DIR=$src
      return
   fi
   [ -f "$src" ] || die "no such file or folder: $src"
   mkdir -p "$TMP_DIR"
   WORK=$(mktemp -d "$TMP_DIR/config-import.XXXXXX")
   case $src in
      *.tar.gz | *.tgz)
         [ "$(stat -c %s "$src")" -le "$MAX_ARCHIVE_BYTES" ] || die "${src##*/}: larger than $MAX_ARCHIVE_BYTES bytes"
         # Only plain files and folders, with relative paths inside the archive.
         tar -tvzf "$src" > "$WORK/.list" 2> /dev/null || die "${src##*/}: not a .tar.gz archive"
         bad=$(awk '$1 !~ /^[-d]/' "$WORK/.list" | head -n 1)
         [ -z "$bad" ] || die "${src##*/}: only files and folders are imported: $bad"
         if tar -tzf "$src" | grep -qE '(^/|(^|/)\.\.(/|$))'; then
            die "${src##*/}: paths must stay inside the archive"
         fi
         rm "$WORK/.list"
         tar -xzf "$src" -C "$WORK" --no-same-owner --no-same-permissions
         ;;
      *.json) cp "$src" "$WORK/${src##*/}" ;;
      *) die "${src##*/}: import a folder, a .json file or a .tar.gz archive" ;;
   esac
   DIR=$WORK
}

# Validate every file first, then back up what is replaced and write the new
# files atomically. A recipes/ folder in the source replaces all recipes, so
# recipes deleted there are deleted on the Pi too. The app watches recipes/
# and may create it at any time, so the folder stays: files are replaced in it.
cmd_import() { # <source>
   local dir files recipes f backup old
   source_dir "$1"
   dir=$DIR
   files=$(config_files "$dir")
   recipes=$(recipe_files "$dir")
   if [ -d "$dir/recipes" ] && [ -z "$recipes" ]; then
      die "recipes/ has no .json files; nothing imported"
   fi
   [ -n "$files$recipes" ] || die "no *.json or recipes/ to import"
   for f in $files; do
      check_file "$dir/$f" "$f" "$CONFIG_RE" "letters, digits, '.', '_' and '-'"
   done
   for f in $recipes; do
      check_file "$dir/recipes/$f" "recipes/$f" "$RECIPE_RE" "letters, digits, '_' and '-'"
   done

   [ -d "$CONFIG_DIR" ] || die "${CONFIG_DIR#"$ROOT"} is missing; reboot to create it"
   backup=$BACKUP_DIR/$(date -u +%Y%m%dT%H%M%SZ)
   if [ -n "$files" ] && compgen -G "$CONFIG_DIR/*.json" > /dev/null; then
      mkdir -p "$backup"
      cp -p "$CONFIG_DIR"/*.json "$backup/"
   fi
   for f in $files; do
      install_file "$dir/$f" "$CONFIG_DIR/$f"
      log "imported $f"
   done

   if [ -n "$recipes" ]; then
      if [ -d "$CONFIG_DIR/recipes" ]; then
         mkdir -p "$backup/recipes"
         cp -p "$CONFIG_DIR/recipes"/*.json "$backup/recipes/" 2> /dev/null || true
      elif mkdir -m 2775 "$CONFIG_DIR/recipes" 2> /dev/null; then
         own "$CONFIG_DIR/recipes"
      fi
      [ -d "$CONFIG_DIR/recipes" ] || die "cannot create ${CONFIG_DIR#"$ROOT"}/recipes"
      for f in $recipes; do
         install_file "$dir/recipes/$f" "$CONFIG_DIR/recipes/$f"
      done
      for old in $(recipe_files "$CONFIG_DIR"); do
         grep -qxF "$old" <<< "$recipes" || rm -f "$CONFIG_DIR/recipes/$old"
      done
      sync "$CONFIG_DIR/recipes"
      log "imported recipes: $(echo "$recipes" | sed 's/\.json$//' | paste -sd ' ')"
   fi
   if [ -d "$backup" ]; then
      chown -hR --reference="${BACKUP_DIR%/*}" "$BACKUP_DIR" # the os folder's owner, like the share
      sync "$backup"
   fi
   sync "$CONFIG_DIR"
   [ ! -d "$backup" ] || log "previous config saved in ${backup#"$ROOT"}"

   warn_boot_pins
   [ -z "$recipes" ] || log "the app shows the new recipes within a few seconds"
   [ -z "$files" ] || log "the app reads its config at start: brewberry-update restart (this ends a running brew)"
}

# config.txt sets the default pins to their off level at boot; other pins are
# only switched off by the reset after a stop.
warn_boot_pins() {
   [ -f "$APP_CONFIG" ] || return 0
   local entry name pin got
   for entry in $DEFAULT_PINS; do
      name=${entry%%:*}
      pin=${entry#*:}
      got=$(jq -r --arg n "$name" '.hardware[$n].pin // empty' "$APP_CONFIG" 2> /dev/null || true)
      if [ -n "$got" ] && [ "$got" != "$pin" ]; then
         log "WARNING: $name is on BCM $got, but config.txt switches BCM $pin off at boot."
         log "         Update the gpio= lines in config.txt in maintenance mode."
      fi
   done
}

cmd_export() {
   [ ! -t 1 ] || die "the archive goes to stdout: brewberry-config export > config.tar.gz"
   local members=()
   mapfile -t members < <(cd "$CONFIG_DIR" && { config_files .; recipe_files . | sed 's|^|recipes/|'; })
   [ ${#members[@]} -gt 0 ] || die "no configuration files in ${CONFIG_DIR#"$ROOT"} (the app writes them at its first start)"
   tar -czf - -C "$CONFIG_DIR" --owner=0 --group=0 "${members[@]}"
}

cmd_show() {
   local config=null
   [ -f "$APP_CONFIG" ] && config=$(jq -c . "$APP_CONFIG" 2> /dev/null || echo '"(not valid JSON)"')
   if [ "$JSON" = 1 ]; then
      jq -n --argjson config "$config" \
         --arg files "$(config_files "$CONFIG_DIR")" --arg recipes "$(recipe_files "$CONFIG_DIR" | sed 's/\.json$//')" \
         --arg folder "$([ -d "$CONFIG_DIR/recipes" ] && echo yes || echo no)" \
         '{config: $config, files: ($files | split("\n") | map(select(. != ""))),
           recipes: (if $folder == "yes" then $recipes | split("\n") | map(select(. != "")) else null end)}'
      return
   fi
   if [ "$config" = null ]; then
      echo "config.json: none yet (the app writes it with its defaults at its next start)"
   else
      echo "config.json:"
      jq . <<< "$config" | sed 's/^/  /'
   fi
   echo "files: $(config_files "$CONFIG_DIR" | paste -sd ' ')"
   if [ -d "$CONFIG_DIR/recipes" ]; then
      echo "recipes: $(recipe_files "$CONFIG_DIR" | sed 's/\.json$//' | paste -sd ' ')"
   else
      echo "recipes: none yet (the app creates recipes/ with its shipped recipes at its next start)"
   fi
}

[ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "run as root"
parse_opts "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
case ${1:-} in
   show) cmd_show ;;
   import) [ $# -eq 2 ] || die "usage: brewberry-config import <folder|file.json|archive.tar.gz>"; cmd_import "$2" ;;
   export) cmd_export ;;
   *) sed -n '2,12s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
