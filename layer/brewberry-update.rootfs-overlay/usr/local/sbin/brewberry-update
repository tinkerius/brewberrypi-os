#!/bin/bash
# Select the BrewberryPi app version on the device (ADR-0001, OS4). Run as root.
#
#   brewberry-update login [--username <user> --password-stdin]
#                                    store the registry token (/data/secrets/auth.json)
#   brewberry-update list            the registry's versions (also written to
#                                    /data/update/tags.json) and the ones on the Pi
#   brewberry-update status          active and previous image, last result
#   brewberry-update download <version>
#                                    pull a version from the registry onto the Pi,
#                                    signature checked by policy.json; nothing switches
#   brewberry-update remove <version>
#                                    delete a downloaded version (never the active or
#                                    the previous one)
#   brewberry-update install <version> [--from-dir <dir>]
#                                    switch to a downloaded version, or to one from a
#                                    'dir:' export (USB, via brewberry-usb, signature
#                                    checked); watch for 60 s, roll back on failure
#   brewberry-update rollback        switch back to the previous image
#   brewberry-update demo on|off     run the app with a simulated kettle
#                                    (--dummymode, never touches GPIO) or normally;
#                                    kept across reboots, restarts the app
#   brewberry-update restart         restart the app (also after a configuration error)
#
# Options: --json (list, status: machine-readable output), --yes (install,
# rollback, demo, restart: don't ask; without it they ask on a terminal, and
# otherwise print what they would do and exit 10). They warn when a brew is
# loaded or running, because restarting the app ends it (ADR-0002).
#
# Images: localhost/brewberrypi:active runs; :previous is the one before; both
# are never garbage-collected. Downloaded versions are kept as
# localhost/brewberrypi:<version> until removed. Nothing else is kept. Never
# 'podman image prune -a'.
set -euo pipefail

PROG=brewberry-update
# BREWBERRY_LIB and BREWBERRY_UPDATE_ROOT are for tests (tests/unit/update.sh).
# shellcheck source=layer/brewberry-base.rootfs-overlay/usr/lib/brewberry/common.sh
. "${BREWBERRY_LIB:-/usr/lib/brewberry}/common.sh"

# BREWBERRY_UPDATE_REPO is for the hardware test only (tests/hardware/os4-check.sh),
# together with a temporary policy entry that a reboot removes.
REPO=${BREWBERRY_UPDATE_REPO:-ghcr.io/tinkerius/brewberrypi}
LOCAL=localhost/brewberrypi
ACTIVE=$LOCAL:active
PREVIOUS=$LOCAL:previous
SERVICE=brewberrypi.service
CONTRACT=1
# The version label of the contract stub the OS image preloads: no app installed yet.
PLACEHOLDER=placeholder
# App versions (runtime contract §1): 1.2.3, or a pre-release 1.2.3-alpha.N, -beta.N, -rc.N.
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$'
# BREWBERRY_SOAK_S is for tests too.
ROOT=${BREWBERRY_UPDATE_ROOT:-}
APP_CONFIG=$ROOT/data/config/config.json
SOAK_S=${BREWBERRY_SOAK_S:-60}
UPDATE_DIR=$ROOT/data/update
STATE=$UPDATE_DIR/state.json
SAFEMODE_MARK=$UPDATE_DIR/safemode.json
# Extra app arguments, read by brewberrypi.service (EnvironmentFile=).
APP_ARGS=$UPDATE_DIR/app-args.env
LOCK=$ROOT/run/brewberry-update.lock
export REGISTRY_AUTH_FILE=$ROOT/data/secrets/auth.json

image_id() { podman image inspect -f '{{.Id}}' "$1" 2>/dev/null || true; }
label() { podman image inspect -f "{{index .Labels \"$2\"}}" "$1" 2>/dev/null || true; }
version_of() { label "$1" org.opencontainers.image.version; }

# The versions downloaded onto the Pi (localhost/brewberrypi:<version>), one per line.
downloads() {
   podman images --noheading --format '{{.Tag}}' "$LOCAL" 2> /dev/null | grep -E "$VERSION_RE" | sort -u || true
}

# The image of a version that is on the Pi: its download, or the active or
# previous image when it is that version (installed before downloads were kept,
# or from a USB stick). Empty when the version isn't on the Pi.
local_image() { # <version>
   local id ref
   id=$(image_id "$LOCAL:$1")
   for ref in "$ACTIVE" "$PREVIOUS"; do
      [ -z "$id" ] && [ "$(version_of "$ref")" = "$1" ] && id=$(image_id "$ref")
   done
   echo "$id"
}

# Megabytes an image takes on /data.
image_mb() { echo $(( $(podman image inspect -f '{{.Size}}' "$1" 2> /dev/null || echo 0) / 1000000 )); }

check_version() { # <version>
   [[ $1 =~ $VERSION_RE ]] || die "not an app version (1.2.3 or 1.2.3-alpha.N/-beta.N/-rc.N): $1"
}

state() { # <phase> <message> [version]
   jq -n --arg phase "$1" --arg message "$2" --arg version "${3:-}" \
      --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{time: $time, phase: $phase, version: $version, message: $message}' | write_atomic "$STATE"
   log "$1: $2"
}

lock() {
   exec 9> "$LOCK"
   flock -n 9 || die "another update or safe-mode switch is running"
}

need_auth() {
   [ -s "$REGISTRY_AUTH_FILE" ] || die "no registry token; run: brewberry-update login"
}

# Restart the app and watch it: it must reach READY (systemctl restart waits for
# it) and then run for SOAK_S without a restart. Returns 0 if healthy, 2 for a
# configuration error (exit code 2 or 3: the image is not to blame, runtime
# contract §2), 1 otherwise.
restart_and_soak() {
   systemctl reset-failed "$SERVICE" 2>/dev/null || true
   if ! systemctl restart "$SERVICE"; then
      config_error && return 2
      return 1
   fi
   local restarts
   restarts=$(systemctl show -p NRestarts --value "$SERVICE")
   log "running; watching for ${SOAK_S}s"
   sleep "$SOAK_S"
   if systemctl is-active --quiet "$SERVICE" &&
      [ "$(systemctl show -p NRestarts --value "$SERVICE")" = "$restarts" ]; then
      return 0
   fi
   config_error && return 2
   return 1
}

config_error() {
   case $(systemctl show -p ExecMainStatus --value "$SERVICE") in
      2 | 3) return 0 ;;
      *) return 1 ;;
   esac
}

# Remove every image that is neither active, previous nor downloaded (and
# dangling layers).
gc() {
   local keep id v
   keep=" $(image_id "$ACTIVE") $(image_id "$PREVIOUS") "
   for v in $(downloads); do keep+="$(image_id "$LOCAL:$v") "; done
   for id in $(podman images -q --no-trunc | sed 's/^sha256://' | sort -u); do
      [[ $keep == *" $id "* ]] && continue
      podman rmi -f -i "$id" > /dev/null || log "could not remove image $id"
   done
   podman image prune -f > /dev/null || true
}

cmd_login() { # [--username <user> --password-stdin]
   install -d -m 0700 "$(dirname "$REGISTRY_AUTH_FILE")"
   if [ $# -eq 3 ] && [ "$1" = --username ] && [ "$3" = --password-stdin ]; then
      [[ $2 =~ ^[A-Za-z0-9-]+$ ]] || die "not a GitHub user name: $2"
      podman login --authfile "$REGISTRY_AUTH_FILE" --username "$2" --password-stdin "${REPO%%/*}"
   elif [ $# -eq 0 ]; then
      echo "Registry token for $REPO: a GitHub classic PAT with read:packages only." >&2
      podman login --authfile "$REGISTRY_AUTH_FILE" "${REPO%%/*}"
   else
      die "usage: brewberry-update login [--username <user> --password-stdin]"
   fi
   chmod 0600 "$REGISTRY_AUTH_FILE"
   sync -f "$(dirname "$REGISTRY_AUTH_FILE")"
}

# jq: newest first in SemVer order (a pre-release sorts before its release:
# 1.2.0-alpha.2 < 1.2.0-beta.1 < 1.2.0).
# shellcheck disable=SC2016  # jq program
SEMVER_DESC='def semver_desc: sort_by(capture("^(?<v>[0-9.]+)(-(?<k>[a-z]+)\\.(?<n>[0-9]+))?$")
   | (.v | split(".") | map(tonumber)) + [if .k then 0 else 1 end, .k // "", (.n // "0" | tonumber)])
   | reverse;'

# The registry's versions and the ones on the Pi. Without a token or a
# network, it still lists the Pi's own versions and says why the registry is
# missing (registryError).
cmd_list() {
   local tags='[]' err="" out v id active previous on_pi='[]'
   if [ ! -s "$REGISTRY_AUTH_FILE" ]; then
      err="no registry token; run: brewberry-update login"
   elif out=$(skopeo --command-timeout 60s list-tags "docker://$REPO" 2>&1); then
      # Version tags only; signature tags (sha256-...) and anything else are left out.
      tags=$(jq -c --arg re "$VERSION_RE" "$SEMVER_DESC"' .Tags | map(select(test($re))) | semver_desc' <<< "$out")
      jq -n --argjson tags "$tags" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg active "$(version_of "$ACTIVE")" \
         '{time: $time, active: $active, tags: $tags}' | write_atomic "$UPDATE_DIR/tags.json"
   else
      err="the registry did not answer: $(tail -n 1 <<< "$out")"
   fi
   active=$(version_of "$ACTIVE")
   previous=$(version_of "$PREVIOUS")
   for v in $( { downloads; echo "$active"; echo "$previous"; } | grep -E "$VERSION_RE" | sort -u); do
      id=$(local_image "$v")
      [ -n "$id" ] || continue
      on_pi=$(jq -c --arg v "$v" --argjson mb "$(image_mb "$id")" --arg a "$active" --arg p "$previous" \
         --argjson dl "$([ -n "$(image_id "$LOCAL:$v")" ] && echo true || echo false)" \
         '. + [{version: $v, mb: $mb, active: ($v == $a), previous: ($v == $p), downloaded: $dl}]' <<< "$on_pi")
   done
   out=$(jq -n -c --argjson tags "$tags" --argjson local "$on_pi" --arg err "$err" --arg active "$active" \
      --arg previous "$previous" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$SEMVER_DESC"'
      def ornull: if . == "" then null else . end;
      {time: $time, active: ($active | ornull), previous: ($previous | ornull), tags: $tags,
       local: ([$local[].version] | semver_desc | map(. as $v | $local[] | select(.version == $v))),
       registryError: ($err | ornull)}')
   if [ "$JSON" = 1 ]; then
      jq . <<< "$out"
      return 0
   fi
   [ -z "$err" ] || log "$err; showing the versions on the Pi only"
   jq -r "$SEMVER_DESC"'
      . as $o | (.tags + [.local[].version] | unique | semver_desc)[] | . as $v
      | ([$o.local[] | select(.version == $v)] | first) as $l
      | if $l then "\($v)  " + ([if $l.active then "active" else empty end, if $l.previous then "previous" else empty end,
           "on the Pi (\($l.mb) MB)"] | join(", "))
        else $v end' <<< "$out"
}

cmd_download() { # <version>
   local version=$1 id mb
   check_version "$version"
   need_auth
   lock
   if [ -n "$(image_id "$LOCAL:$version")" ]; then
      log "$version is already downloaded"
      return 0
   fi
   id=$(local_image "$version")
   if [ -n "$id" ]; then
      podman tag "$id" "$LOCAL:$version"
      log "$version is already on the Pi (active or previous); kept as a download too"
      return 0
   fi
   state downloading "downloading $version from $REPO (signature checked)" "$version"
   if ! id=$(podman pull -q "$REPO:$version"); then
      state failed "download failed or the signature was rejected; nothing changed" "$version"
      exit 1
   fi
   id=$(image_id "$id")
   podman untag "$id" "$REPO:$version" || true
   if [ "$(label "$id" org.brewberrypi.runtime-contract)" != "$CONTRACT" ]; then
      gc
      state failed "$version does not implement runtime contract $CONTRACT; not kept" "$version"
      exit 1
   fi
   if [ "$(version_of "$id")" != "$version" ]; then
      gc
      state failed "the image says it is version '$(version_of "$id")', not $version; not kept" "$version"
      exit 1
   fi
   podman tag "$id" "$LOCAL:$version"
   mb=$(image_mb "$id")
   state downloaded "$version is downloaded ($mb MB); install it to switch to it" "$version"
}

cmd_remove() { # <version>
   local version=$1 id
   check_version "$version"
   lock
   id=$(image_id "$LOCAL:$version")
   if [ "$(version_of "$ACTIVE")" = "$version" ] || { [ -n "$id" ] && [ "$id" = "$(image_id "$ACTIVE")" ]; }; then
      die "$version is the active version; it stays on the Pi"
   fi
   if [ "$(version_of "$PREVIOUS")" = "$version" ] || { [ -n "$id" ] && [ "$id" = "$(image_id "$PREVIOUS")" ]; }; then
      die "$version is the previous version, kept to roll back to; it stays on the Pi"
   fi
   [ -n "$id" ] || die "$version is not downloaded"
   podman untag "$id" "$LOCAL:$version" || die "could not remove $version"
   gc
   log "removed $version"
}

cmd_status() {
   [ "$JSON" = 0 ] || { status_json; return 0; }
   local ref
   local v
   for ref in "$ACTIVE" "$PREVIOUS"; do
      v=$(label "$ref" org.opencontainers.image.version)
      [ "$v" != "$PLACEHOLDER" ] || v="placeholder (no app installed)"
      printf '%-32s %-10s %s\n' "$ref" "$v" "$(image_id "$ref" | cut -c1-12)"
   done
   echo
   systemctl is-active "$SERVICE" || true
   [ -f "$STATE" ] && jq . "$STATE"
   [ -f "$SAFEMODE_MARK" ] && { echo "safe mode:"; jq . "$SAFEMODE_MARK"; }
   echo "demo mode: $(demo_state)"
   return 0
}

status_json() {
   local ref out=() state=null safemode=null
   for ref in "$ACTIVE" "$PREVIOUS"; do
      out+=("$(jq -n --arg v "$(label "$ref" org.opencontainers.image.version)" --arg id "$(image_id "$ref")" \
         --arg p "$PLACEHOLDER" 'if $id == "" then null else {version: $v, id: $id[0:12], placeholder: ($v == $p)} end')")
   done
   [ -f "$STATE" ] && state=$(jq -c . "$STATE" 2> /dev/null || echo null)
   [ -f "$SAFEMODE_MARK" ] && safemode=$(jq -c . "$SAFEMODE_MARK" 2> /dev/null || echo null)
   jq -n --argjson active "${out[0]}" --argjson previous "${out[1]}" \
      --arg service "$(systemctl is-active "$SERVICE" 2> /dev/null || true)" --arg engine "$(engine_state)" \
      --argjson last "$state" --argjson safemode "$safemode" --arg demo "$(demo_state)" \
      '{active: $active, previous: $previous, service: $service,
        engine: (if $engine == "" then null else $engine end),
        last: $last, safemode: $safemode, demo: ($demo == "on")}'
}

demo_state() {
   if grep -qx 'BREWBERRYPI_ARGS=--dummymode' "$APP_ARGS" 2>/dev/null; then echo on; else echo off; fi
}

cmd_demo() { # on|off
   confirm "This switches demo mode $1 and restarts the app."
   lock
   case $1 in
      on) echo 'BREWBERRYPI_ARGS=--dummymode' | write_atomic "$APP_ARGS" ;;
      off) rm -f "$APP_ARGS"; sync "$UPDATE_DIR" ;;
   esac
   log "demo mode $1; restarting the app"
   systemctl reset-failed "$SERVICE" 2>/dev/null || true
   systemctl restart "$SERVICE" || die "the app did not start; see: journalctl -u $SERVICE -b"
   log "demo mode: $(demo_state)"
}

# Restart the app, as after a configuration change. Reports a configuration
# error (exit code 2 or 3) like install does; never switches images.
cmd_restart() {
   confirm "This restarts the app."
   lock
   systemctl reset-failed "$SERVICE" 2>/dev/null || true
   if systemctl restart "$SERVICE"; then
      log "the app is running"
      return 0
   fi
   if config_error; then
      die "the app refuses its configuration (exit code $(systemctl show -p ExecMainStatus --value "$SERVICE")); fix /data/config"
   fi
   die "the app did not start; see: journalctl -u $SERVICE -b"
}

cmd_install() { # <version> [dir: export]
   local version=$1 from_dir=${2:-} new old prev_before rc
   check_version "$version"
   if [ -n "$from_dir" ]; then
      [ -f "$from_dir/manifest.json" ] || die "no image in $from_dir"
   else
      [ -n "$(local_image "$version")" ] || die "$version is not on the Pi; download it first: brewberry-update download $version"
   fi
   confirm "This installs $version and restarts the app; if it fails within ${SOAK_S} s, the previous version comes back."
   lock

   if [ -n "$from_dir" ]; then
      state pulling "pulling dir:$from_dir" "$version"
      if ! new=$(podman pull -q "dir:$from_dir"); then
         state failed "pull failed or the signature was rejected; nothing changed" "$version"
         exit 1
      fi
      new=$(image_id "$new")
   else
      new=$(local_image "$version")
      [ -n "$new" ] || die "$version is no longer on the Pi"
   fi
   old=$(image_id "$ACTIVE")

   if [ "$new" = "$old" ]; then
      state "done" "$version is already active" "$version"
      return 0
   fi
   if [ "$(label "$new" org.brewberrypi.runtime-contract)" != "$CONTRACT" ]; then
      gc
      state failed "$version does not implement runtime contract $CONTRACT; nothing changed" "$version"
      exit 1
   fi
   if [ "$(label "$new" org.opencontainers.image.version)" != "$version" ]; then
      gc
      state failed "the image says it is version '$(label "$new" org.opencontainers.image.version)', not $version; nothing changed" "$version"
      exit 1
   fi

   prev_before=$(image_id "$PREVIOUS")
   state switching "switching to $version" "$version"
   [ -n "$old" ] && podman tag "$old" "$PREVIOUS"
   podman tag "$new" "$ACTIVE"
   rm -f "$SAFEMODE_MARK"

   rc=0
   restart_and_soak || rc=$?
   case $rc in
      0)
         gc
         state "done" "$version is active" "$version"
         ;;
      2)
         gc
         state config-error "$version refuses the configuration (exit code $(systemctl show -p ExecMainStatus --value "$SERVICE")); fix /data/config, the image is kept" "$version"
         exit 1
         ;;
      *)
         log "$version failed; rolling back"
         if [ -n "$old" ]; then
            podman tag "$old" "$ACTIVE"
            if [ -n "$prev_before" ]; then podman tag "$prev_before" "$PREVIOUS"; else podman untag "$old" "$PREVIOUS" || true; fi
         fi
         gc
         systemctl reset-failed "$SERVICE" 2>/dev/null || true
         systemctl restart "$SERVICE" || true
         state rolled-back "$version failed to start or crashed within ${SOAK_S}s; rejected, back to the previous version" "$version"
         [ -z "$(image_id "$LOCAL:$version")" ] || log "$version stays downloaded; remove it with: brewberry-update remove $version"
         exit 1
         ;;
   esac
}

cmd_rollback() {
   local a p rc
   [ -n "$(image_id "$PREVIOUS")" ] || die "there is no previous image"
   confirm "This switches back to the previous version ($(label "$PREVIOUS" org.opencontainers.image.version)) and restarts the app."
   lock
   a=$(image_id "$ACTIVE")
   p=$(image_id "$PREVIOUS")
   [ -n "$p" ] || die "there is no previous image"
   state switching "rolling back to $(label "$p" org.opencontainers.image.version)"
   podman tag "$p" "$ACTIVE"
   podman tag "$a" "$PREVIOUS"
   rm -f "$SAFEMODE_MARK"
   rc=0
   restart_and_soak || rc=$?
   if [ "$rc" -eq 1 ]; then
      podman tag "$a" "$ACTIVE"
      podman tag "$p" "$PREVIOUS"
      systemctl reset-failed "$SERVICE" 2>/dev/null || true
      systemctl restart "$SERVICE" || true
      state failed "the previous image failed too; switched back"
      exit 1
   fi
   state "done" "rolled back to $(label "$ACTIVE" org.opencontainers.image.version)"
}

[ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "run as root"
install -d -m 0755 "$UPDATE_DIR"
parse_opts "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
case ${1:-} in
   login) shift; cmd_login "$@" ;;
   list) cmd_list ;;
   status) cmd_status ;;
   download) [ $# -eq 2 ] || die "usage: brewberry-update download <version>"; cmd_download "$2" ;;
   remove) [ $# -eq 2 ] || die "usage: brewberry-update remove <version>"; cmd_remove "$2" ;;
   install)
      if [ $# -eq 2 ]; then cmd_install "$2"
      elif [ $# -eq 4 ] && [ "$3" = --from-dir ]; then cmd_install "$2" "$4"
      else die "usage: brewberry-update install <version> [--from-dir <dir>]"; fi ;;
   rollback) cmd_rollback ;;
   demo)
      case ${2:-} in
         on | off) cmd_demo "$2" ;;
         *) die "usage: brewberry-update demo on|off" ;;
      esac ;;
   restart) cmd_restart ;;
   *) sed -n '2,30s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
