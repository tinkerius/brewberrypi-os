#!/bin/bash
# Offline updates and config import from a USB stick (ADR-0001, OS5). Run as root.
#
#   brewberry-usb list               versions and config files on the stick
#   brewberry-usb install <version>  install brewberrypi/images/<version> from the stick
#                                    (signature checked like a registry pull)
#   brewberry-usb import-config      copy brewberrypi/config/*.json and recipes/ to /data/config
#
# Stick layout (scripts/usb-export.sh writes it):
#   brewberrypi/images/<version>/ 'dir:' export of ghcr.io/tinkerius/brewberrypi:<version>,
#                                 with its cosign signature (skopeo copy --all)
#   brewberrypi/config/*.json     config.json
#   brewberrypi/config/recipes/   one file <id>.json per recipe (app RCP-001); replaces
#                                 all recipes on the Pi. Without it the recipes stay as they are.
#
# The stick is mounted read-only (nosuid, nodev, noexec) at /media/brewberry-usb,
# the only USB path policy.json accepts signed images from, and unmounted again.
set -euo pipefail

# BREWBERRY_UPDATE_ROOT and BREWBERRY_USB_DIR are for tests (tests/unit/usb.sh):
# a root prefix for /data, and an already mounted stick.
ROOT=${BREWBERRY_UPDATE_ROOT:-}
MNT=/media/brewberry-usb
CONFIG_DIR=$ROOT/data/config
MAX_CONFIG_BYTES=1048576
DEFAULT_PINS="heating:23 pump:22 buzzer:10"

log() { echo "brewberry-usb: $*" >&2; }
die() { log "$*"; exit 1; }

STICK=""
mounted=0
cleanup() { if [ "$mounted" = 1 ]; then umount "$MNT" || log "could not unmount $MNT"; fi; }
trap cleanup EXIT

# Mount the first USB stick that has a brewberrypi/ folder; sets STICK.
mount_stick() {
   if [ -n "${BREWBERRY_USB_DIR:-}" ]; then
      STICK=$BREWBERRY_USB_DIR
      return
   fi
   mountpoint -q "$MNT" && die "$MNT is already mounted"
   mkdir -p "$MNT"
   local link dev seen=" "
   for link in /dev/disk/by-id/usb-*; do
      [ -e "$link" ] || continue
      dev=$(readlink -f "$link")
      case $seen in *" $dev "*) continue ;; esac
      seen="$seen$dev "
      mount -o ro,nosuid,nodev,noexec "$dev" "$MNT" 2> /dev/null || continue
      if [ -d "$MNT/brewberrypi" ]; then
         mounted=1
         STICK=$MNT
         log "using $dev"
         return
      fi
      umount "$MNT"
   done
   die "no USB stick with a brewberrypi/ folder found"
}

# App versions (runtime contract §1): 1.2.3, or a pre-release 1.2.3-alpha.N, -beta.N, -rc.N.
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$'

versions() { # app versions on the stick, newest first in SemVer order (1.2.0-rc.1 < 1.2.0)
   [ -d "$STICK/brewberrypi/images" ] || return 0
   find "$STICK/brewberrypi/images" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
      grep -E "$VERSION_RE" |
      awk '{ n = split($0, p, /[.-]/); rel = (n == 3)
             print p[1], p[2], p[3], rel, (rel ? "-" : p[4]), (rel ? 0 : p[5]), $0 }' |
      sort -k1,1nr -k2,2nr -k3,3nr -k4,4nr -k5,5r -k6,6nr | cut -d' ' -f7 || true
}

config_files() {
   [ -d "$STICK/brewberrypi/config" ] || return 0
   find "$STICK/brewberrypi/config" -mindepth 1 -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort
}

recipe_files() { # the app reads only <id>.json files directly in recipes/
   [ -d "$STICK/brewberrypi/config/recipes" ] || return 0
   find "$STICK/brewberrypi/config/recipes" -mindepth 1 -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort
}

# check_file <path on the stick> <name shown> <name pattern> <pattern description>
check_file() {
   [[ ${1##*/} =~ $3 ]] || die "$2: file names may only contain $4"
   [ "$(stat -c %s "$1")" -le "$MAX_CONFIG_BYTES" ] || die "$2: larger than $MAX_CONFIG_BYTES bytes"
   jq empty "$1" 2> /dev/null || die "$2: not valid JSON; nothing imported"
}

# install_file <source> <target>: copy via a temp file and rename, so a power cut leaves the old or the new file.
install_file() {
   cp "$1" "$2.tmp"
   chmod 0644 "$2.tmp"
   sync "$2.tmp"
   mv "$2.tmp" "$2"
}

cmd_list() {
   mount_stick
   echo "versions:"
   versions | sed 's/^/  /'
   echo "config files:"
   config_files | sed 's/^/  /'
   recipe_files | sed 's/^/  recipes\//'
}

cmd_install() {
   local version=$1
   mount_stick
   [ -d "$STICK/brewberrypi/images/$version" ] || die "no brewberrypi/images/$version on the stick"
   brewberry-update install "$version" --from-dir "$STICK/brewberrypi/images/$version"
}

# Validate every file first, then back up what is replaced and write the new
# files atomically. Nothing is changed if any file is invalid. A recipes/
# folder on the stick replaces the whole recipe folder, so recipes deleted on
# the stick are deleted on the Pi too; without one the recipes stay as they are.
cmd_import_config() {
   mount_stick
   local files recipes f backup new_recipes
   files=$(config_files)
   recipes=$(recipe_files)
   if [ -d "$STICK/brewberrypi/config/recipes" ] && [ -z "$recipes" ]; then
      die "brewberrypi/config/recipes/ has no .json files; nothing imported"
   fi
   [ -n "$files$recipes" ] || die "no brewberrypi/config/*.json or recipes/ on the stick"
   for f in $files; do
      check_file "$STICK/brewberrypi/config/$f" "$f" '^[A-Za-z0-9._-]+\.json$' "letters, digits, '.', '_' and '-'"
   done
   for f in $recipes; do # the file name is the recipe id
      check_file "$STICK/brewberrypi/config/recipes/$f" "recipes/$f" '^[A-Za-z0-9_-]+\.json$' "letters, digits, '_' and '-'"
   done

   mkdir -p "$CONFIG_DIR"
   backup=$CONFIG_DIR/backup/$(date -u +%Y%m%dT%H%M%SZ)
   if [ -n "$files" ] && compgen -G "$CONFIG_DIR/*.json" > /dev/null; then
      mkdir -p "$backup"
      cp -p "$CONFIG_DIR"/*.json "$backup/"
   fi
   for f in $files; do
      install_file "$STICK/brewberrypi/config/$f" "$CONFIG_DIR/$f"
      log "imported $f"
   done

   if [ -n "$recipes" ]; then
      # Stage the new folder next to the old one, then swap them with two
      # renames; the old folder moves into the backup.
      new_recipes=$CONFIG_DIR/.recipes.new
      rm -rf "$new_recipes"
      mkdir -m 0755 "$new_recipes"
      for f in $recipes; do
         install_file "$STICK/brewberrypi/config/recipes/$f" "$new_recipes/$f"
      done
      sync "$new_recipes"
      if [ -d "$CONFIG_DIR/recipes" ]; then
         mkdir -p "$backup"
         mv "$CONFIG_DIR/recipes" "$backup/recipes"
      fi
      mv "$new_recipes" "$CONFIG_DIR/recipes"
      log "imported recipes: $(echo "$recipes" | sed 's/\.json$//' | paste -sd ' ')"
   fi
   sync "$CONFIG_DIR"
   [ ! -d "$backup" ] || log "previous config saved in ${backup#"$ROOT"}"

   warn_boot_pins
   log "the app reads its config at start: systemctl restart brewberrypi (this ends a running brew)"
}

# config.txt sets the default pins to their off level at boot; other pins are
# only switched off by the reset after a stop.
warn_boot_pins() {
   [ -f "$CONFIG_DIR/config.json" ] || return 0
   local entry name pin got
   for entry in $DEFAULT_PINS; do
      name=${entry%%:*}
      pin=${entry#*:}
      got=$(jq -r --arg n "$name" '.hardware[$n].pin // empty' "$CONFIG_DIR/config.json" 2> /dev/null || true)
      if [ -n "$got" ] && [ "$got" != "$pin" ]; then
         log "WARNING: $name is on BCM $got, but config.txt switches BCM $pin off at boot."
         log "         Update the gpio= lines in config.txt in maintenance mode."
      fi
   done
}

[ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "run as root"
case ${1:-} in
   list) cmd_list ;;
   install) [ $# -eq 2 ] || die "usage: brewberry-usb install <version>"; cmd_install "$2" ;;
   import-config) cmd_import_config ;;
   *) sed -n '2,7s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
