#!/bin/bash
# Offline updates and config import from a USB stick (ADR-0001, OS5). Run as root.
#
#   brewberry-usb list               versions and config files on the stick
#   brewberry-usb install <version>  install brewberrypi/images/<version> from the stick
#                                    (signature checked like a registry pull)
#   brewberry-usb import-config      copy brewberrypi/config/*.json and recipes/ to /data/config
#                                    (brewberry-config import)
#
# Options: --json (list), --yes (install, see brewberry-update).
#
# Stick layout (scripts/usb-export.sh writes it):
#   brewberrypi/images/<version>/ 'dir:' export of ghcr.io/tinkerius/brewberrypi:<version>,
#                                 with its cosign signature (skopeo copy --all)
#   brewberrypi/config/*.json     config.json
#   brewberrypi/config/recipes/   one file <id>.json per recipe (app RCP-001); replaces
#                                 all recipes on the Pi. Without it the recipes stay as they are.
#
# The stick is mounted read-only (nosuid, nodev, noexec) at /media/brewberry-usb,
# the only USB path policy.json accepts signed images from, and unmounted again.
set -euo pipefail

PROG=brewberry-usb
# BREWBERRY_LIB, BREWBERRY_UPDATE_ROOT and BREWBERRY_USB_DIR are for tests
# (tests/unit/usb.sh): a root prefix for /data, and an already mounted stick.
# shellcheck source=layer/brewberry-base.rootfs-overlay/usr/lib/brewberry/common.sh
. "${BREWBERRY_LIB:-/usr/lib/brewberry}/common.sh"
ROOT=${BREWBERRY_UPDATE_ROOT:-}
APP_CONFIG=$ROOT/data/config/config.json
MNT=/media/brewberry-usb

STICK=""
mounted=0
cleanup() { if [ "$mounted" = 1 ]; then umount "$MNT" || log "could not unmount $MNT"; fi; }
trap cleanup EXIT

# Mount the first USB stick that has a brewberrypi/ folder; sets STICK.
mount_stick() {
   if [ -n "${BREWBERRY_USB_DIR:-}" ]; then
      STICK=$BREWBERRY_USB_DIR
      return
   fi
   mountpoint -q "$MNT" && die "$MNT is already mounted"
   mkdir -p "$MNT"
   local link dev seen=" "
   for link in /dev/disk/by-id/usb-*; do
      [ -e "$link" ] || continue
      dev=$(readlink -f "$link")
      case $seen in *" $dev "*) continue ;; esac
      seen="$seen$dev "
      mount -o ro,nosuid,nodev,noexec "$dev" "$MNT" 2> /dev/null || continue
      if [ -d "$MNT/brewberrypi" ]; then
         mounted=1
         STICK=$MNT
         log "using $dev"
         return
      fi
      umount "$MNT"
   done
   die "no USB stick with a brewberrypi/ folder found"
}

# App versions (runtime contract §1): 1.2.3, or a pre-release 1.2.3-alpha.N, -beta.N, -rc.N.
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$'

versions() { # app versions on the stick, newest first in SemVer order (1.2.0-rc.1 < 1.2.0)
   [ -d "$STICK/brewberrypi/images" ] || return 0
   find "$STICK/brewberrypi/images" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
      grep -E "$VERSION_RE" |
      awk '{ n = split($0, p, /[.-]/); rel = (n == 3)
             print p[1], p[2], p[3], rel, (rel ? "-" : p[4]), (rel ? 0 : p[5]), $0 }' |
      sort -k1,1nr -k2,2nr -k3,3nr -k4,4nr -k5,5r -k6,6nr | cut -d' ' -f7 || true
}

config_files() {
   [ -d "$STICK/brewberrypi/config" ] || return 0
   find "$STICK/brewberrypi/config" -mindepth 1 -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort
}

recipe_files() { # the app reads only <id>.json files directly in recipes/
   [ -d "$STICK/brewberrypi/config/recipes" ] || return 0
   find "$STICK/brewberrypi/config/recipes" -mindepth 1 -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort
}

cmd_list() {
   mount_stick
   if [ "$JSON" = 1 ]; then
      jq -n --arg v "$(versions)" --arg c "$(config_files)" --arg r "$(recipe_files | sed 's/\.json$//')" \
         'def lines: split("\n") | map(select(. != ""));
          {versions: ($v | lines), config: ($c | lines), recipes: ($r | lines)}'
      return
   fi
   echo "versions:"
   versions | sed 's/^/  /'
   echo "config files:"
   config_files | sed 's/^/  /'
   recipe_files | sed 's/^/  recipes\//'
}

# The checks, the switch and the rollback are brewberry-update's, so it also
# asks for confirmation; --yes and --json are passed on.
cmd_install() {
   local version=$1 opts=()
   [[ $version =~ $VERSION_RE ]] || die "not an app version (1.2.3 or 1.2.3-alpha.N/-beta.N/-rc.N): $version"
   mount_stick
   [ -d "$STICK/brewberrypi/images/$version" ] || die "no brewberrypi/images/$version on the stick"
   [ "$YES" = 0 ] || opts+=(--yes)
   [ "$JSON" = 0 ] || opts+=(--json)
   brewberry-update install "$version" --from-dir "$STICK/brewberrypi/images/$version" "${opts[@]+"${opts[@]}"}"
}

# The same checks, backup and atomic writes as every config import.
cmd_import_config() {
   mount_stick
   [ -d "$STICK/brewberrypi/config" ] || die "no brewberrypi/config/ on the stick"
   brewberry-config import "$STICK/brewberrypi/config"
}

[ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "run as root"
parse_opts "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
case ${1:-} in
   list) cmd_list ;;
   install) [ $# -eq 2 ] || die "usage: brewberry-usb install <version>"; cmd_install "$2" ;;
   import-config) cmd_import_config ;;
   *) sed -n '2,10s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
