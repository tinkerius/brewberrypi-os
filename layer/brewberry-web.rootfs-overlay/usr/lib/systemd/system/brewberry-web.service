# Device web interface on port 8081 (ADR-0002, OS9). Unprivileged: every
# action goes to the root helper (brewberry-webcmd.socket), which runs only
# catalogue commands.
[Unit]
Description=BrewberryPi OS web interface (port 8081)
After=network.target brewberry-webcmd.socket brewberry-passwd-restore.service
Wants=brewberry-webcmd.socket

[Service]
ExecStart=/usr/bin/python3 /usr/lib/brewberry-web/server.py
User=brewberry-web
Group=brewberry-web
Restart=always
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=96M

[Install]
WantedBy=multi-user.target
