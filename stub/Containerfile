# BrewberryPi contract stub image (runtime contract version 2). Unlike the app, it writes
# nothing into /config, so the app still finds no config.json and recipes/ at its first start.
# Same base, user and entrypoint as the app image (tinkerius/brewberrypi-app Containerfile), so the
# host is tested against the same conditions. Build: scripts/build-stub.sh
FROM docker.io/library/debian:trixie-slim

ARG VERSION=placeholder
# Default start mode: ok, crash, hwfail, config or hang (see brewberrypi-stub.py).
ARG START=ok

LABEL org.opencontainers.image.title="BrewberryPi contract stub" \
      org.opencontainers.image.source="https://github.com/tinkerius/brewberrypi-os" \
      org.opencontainers.image.version="${VERSION}" \
      org.brewberrypi.runtime-contract="2"

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-libgpiod \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --user-group --no-create-home --home-dir /nonexistent brewberrypi

COPY brewberrypi-stub.py /usr/local/bin/brewberrypi
# The BrewberryPi brand files of the "app not installed" page (scripts/sync-brand.sh).
COPY static/ /usr/local/share/brewberrypi-stub/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BREWBERRYPI_STUB_VERSION="${VERSION}" \
    BREWBERRYPI_STUB_START="${START}" \
    BREWBERRYPI_STUB_STATIC=/usr/local/share/brewberrypi-stub
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["brewberrypi"]
CMD ["--config", "/config/config.json"]
